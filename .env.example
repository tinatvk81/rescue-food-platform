# Environment: development | production
NODE_ENV=development

# Server port
PORT=3000

# MongoDB connection string (local Docker/mongod, or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/rescue-food-platform

# JWT settings
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# Publicly reachable base URL of THIS API (used to build the Zarinpal
# callback URL). Zarinpal's flow redirects the CUSTOMER'S BROWSER back to
# this URL after they pay (it is not a server-to-server call), so
# http://localhost:3000 works fine for local testing as long as you open
# the payment link in a browser on the same machine.
APP_BASE_URL=http://localhost:3000

# Zarinpal payment gateway
# Leave ZARINPAL_MERCHANT_ID unset to use Zarinpal's public sandbox
# merchant id automatically (safe for testing, moves no real money).
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
